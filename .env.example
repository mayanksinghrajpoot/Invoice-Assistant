# CSE476 T8 Invoice Assistant — pick one lane.
# Copy this file to .env and fill in the values you actually have.

# groq (free, default) | foundry | local
PROVIDER=groq

# Groq: https://console.groq.com/keys
GROQ_API_KEY=

# Microsoft Foundry (optional). Endpoint must end in /openai/v1/
# AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/openai/v1/
# AZURE_OPENAI_API_KEY=
# MODEL=chat-demo

# Ollama on this machine (optional). No key needed.
# PROVIDER=local
# MODEL=llama3.2
